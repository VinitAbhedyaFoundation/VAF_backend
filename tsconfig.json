{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2021",

    "rootDir": "./",
    "outDir": "./dist",

    "moduleResolution": "Node16",

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "strict": true,
    "skipLibCheck": true,

    "sourceMap": true,

    "types": ["node", "jest"]
  },

  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "test"
  ]
}