generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// 🔹 USER
//////////////////////////////////////////////////////

model User {
  id                   Int             @id @default(autoincrement())
  name                 String
  email                String          @unique
  password             String
  phone                String
  parentNumber         String
  bloodGroup           BloodGroup
  birthDate            DateTime
  gender               Gender
  occupation           Occupation
  highestQualification String
  address              String
  city                 String?
  state                String?
  collegeOrCompany     String?
  role                 Role
  drivesCount          Int             @default(0)
  ploggerId            String          @unique
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  // 🔗 Relations
  participations Participation[]
  messagesSent   Message[]
  notifications  Notification[]

  @@index([email])
}

//////////////////////////////////////////////////////
// 🔹 DRIVE
//////////////////////////////////////////////////////

model Drive {
  id             Int             @id @default(autoincrement())
  title          String?
  date           DateTime
  totalHours     Int
  volunteerCount Int             @default(0)
  temporaryToken String          @unique
  expiryDate     DateTime
  locationId     Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  driveLocation  DriveLocation   @relation(fields: [locationId], references: [id])
  participations Participation[]

  @@index([locationId])
  @@index([temporaryToken])
}

//////////////////////////////////////////////////////
// 🔹 DRIVE LOCATION
//////////////////////////////////////////////////////

model DriveLocation {
  id        Int      @id @default(autoincrement())
  location  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  drives    Drive[]
}

//////////////////////////////////////////////////////
// 🔹 PARTICIPATION (CORE ANALYTICS)
//////////////////////////////////////////////////////

model Participation {
  id        Int      @id @default(autoincrement())
  userId    Int
  driveId   Int
  hours     Int      @default(0)
  waste     Int      @default(0)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  drive Drive @relation(fields: [driveId], references: [id])

  @@unique([userId, driveId])
  @@index([userId])
  @@index([driveId])
}

//////////////////////////////////////////////////////
// 🔹 MESSAGE (BROADCAST SYSTEM)
//////////////////////////////////////////////////////

model Message {
  id          Int      @id @default(autoincrement())
  subject     String
  content     String

  senderId    Int
  sender      User     @relation(fields: [senderId], references: [id])

  isBroadcast Boolean  @default(true)

  createdAt   DateTime @default(now())

  @@index([senderId])
}

//////////////////////////////////////////////////////
// 🔹 NOTIFICATION (OPTIONAL FEATURE)
//////////////////////////////////////////////////////

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

//////////////////////////////////////////////////////
// 🔹 ENUMS
//////////////////////////////////////////////////////

enum Gender {
  Male
  Female
  Other
}

enum Occupation {
  Student
  WorkingProfessional
  Other
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum Role {
  User
  Admin
  SuperAdmin
}