generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int             @id @default(autoincrement())
  name                 String
  email                String          @unique
  password             String
  phone                String?
  parentNumber         String?
  bloodGroup           BloodGroup?
  birthDate            DateTime?
  gender               Gender?
  occupation           Occupation?
  highestQualification String?
  address              String?
  city                 String?
  state                String?
  collegeOrCompany     String?
  role                 Role            @default(User)
  drivesCount          Int             @default(0)
  ploggerId            String          @unique
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  status               UserStatus      @default(Pending)
  certificates         Certificate[]
  messagesSent         Message[]
  notifications        Notification[]
  participations       Participation[]

  @@index([email])
}

model Drive {
  id                    Int         @id @default(autoincrement())
  title                 String?
  description           String?
  initiative            Initiative?
  date                  DateTime
  totalHours            Int
  totalWasteKg          Int         @default(0)
  volunteerCount        Int         @default(0)
  temporaryToken        String      @unique
  expiryDate            DateTime?
  locationId            Int
  certificateTemplateId Int?
  driveResourcesUrl     String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  certificateIssued     Boolean     @default(false)
  completed             Boolean     @default(false)

  certificates        Certificate[]
  driveLocation       DriveLocation        @relation(fields: [locationId], references: [id])
  participations      Participation[]
  guestVolunteers     GuestVolunteer[]
  certificateTemplate CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id], onDelete: SetNull)

  @@index([locationId])
  @@index([temporaryToken])
  @@index([initiative])
  @@index([certificateTemplateId])
}

model DriveLocation {
  id        Int      @id @default(autoincrement())
  location  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  drives    Drive[]
}

model Participation {
  id               Int              @id @default(autoincrement())
  userId           Int
  driveId          Int
  hours            Int              @default(0)
  waste            Int              @default(0)
  createdAt        DateTime         @default(now())
  status           AttendanceStatus @default(Registered)
  attendanceMarked Boolean          @default(false)
  drive            Drive            @relation(fields: [driveId], references: [id])
  user             User             @relation(fields: [userId], references: [id])

  @@unique([userId, driveId])
  @@index([userId])
  @@index([driveId])
  @@index([status])
}

model Message {
  id          Int      @id @default(autoincrement())
  subject     String
  content     String
  senderId    Int
  recipients  Int      @default(0)
  isBroadcast Boolean  @default(true)
  createdAt   DateTime @default(now())
  sender      User     @relation(fields: [senderId], references: [id])

  @@index([senderId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model CertificateTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  fileUrl   String
  publicId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drives Drive[]

  @@index([name])
}

model Certificate {
  id       Int      @id @default(autoincrement())
  userId   Int
  driveId  Int
  fileUrl  String?
  issuedAt DateTime @default(now())

  drive Drive @relation(fields: [driveId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([userId, driveId])
  @@index([userId])
  @@index([driveId])
}

enum Gender {
  Male
  Female
  Other
}

enum Occupation {
  Student
  WorkingProfessional
  Other
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum Role {
  User
  Admin
  SuperAdmin
}

enum UserStatus {
  Pending
  Approved
  Suspended
}

enum AttendanceStatus {
  Pending
  Approved
  Rejected
  Registered
}

enum Initiative {
  LAAL_BINDI
  SOCIAL_SHELF
  SAMBHAJINAGAR_PLOGGERS
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  @@index([email])
}

model GuestVolunteer {
  id        Int      @id @default(autoincrement())
  driveId   Int
  name      String
  hours     Int      @default(0)
  waste     Int      @default(0)
  createdAt DateTime @default(now())

  drive Drive @relation(fields: [driveId], references: [id], onDelete: Cascade)

  @@index([driveId])
}
