generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int             @id @default(autoincrement())
  name                 String
  email                String          @unique
  password             String
  phone                String?
  parentNumber         String?
  bloodGroup           BloodGroup?
  birthDate            DateTime?
  gender               Gender?
  occupation           Occupation?
  highestQualification String?
  address              String?
  city                 String?
  state                String?
  collegeOrCompany     String?
  role                 Role            @default(User)
  drivesCount          Int             @default(0)
  ploggerId            String          @unique
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  status               UserStatus      @default(Pending)
  certificates         Certificate[]
  messagesSent         Message[]
  notifications        Notification[]
  participations       Participation[]

  @@index([email])
}

model Drive {
  id                Int             @id @default(autoincrement())
  date              DateTime
  totalHours        Int
  volunteerCount    Int             @default(0)
  temporaryToken    String          @unique
  expiryDate        DateTime?
  locationId        Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  title             String?
  certificateIssued Boolean         @default(false)
  completed         Boolean         @default(false)
  certificates      Certificate[]
  driveLocation     DriveLocation   @relation(fields: [locationId], references: [id])
  participations    Participation[]

  @@index([locationId])
  @@index([temporaryToken])
}

model DriveLocation {
  id        Int      @id @default(autoincrement())
  location  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  drives    Drive[]
}

model Participation {
  id               Int              @id @default(autoincrement())
  userId           Int
  driveId          Int
  hours            Int              @default(0)
  waste            Int              @default(0)
  createdAt        DateTime         @default(now())
  status           AttendanceStatus @default(Registered)
  attendanceMarked Boolean          @default(false)
  drive            Drive            @relation(fields: [driveId], references: [id])
  user             User             @relation(fields: [userId], references: [id])

  @@unique([userId, driveId])
  @@index([userId])
  @@index([driveId])
  @@index([status])
}

model Message {
  id          Int      @id @default(autoincrement())
  subject     String
  content     String
  senderId    Int
  isBroadcast Boolean  @default(true)
  createdAt   DateTime @default(now())
  sender      User     @relation(fields: [senderId], references: [id])

  @@index([senderId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Certificate {
  id       Int      @id @default(autoincrement())
  userId   Int
  driveId  Int
  fileUrl  String?
  issuedAt DateTime @default(now())
  drive    Drive    @relation(fields: [driveId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, driveId])
  @@index([userId])
  @@index([driveId])
}

enum Gender {
  Male
  Female
  Other
}

enum Occupation {
  Student
  WorkingProfessional
  Other
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum Role {
  User
  Admin
  SuperAdmin
}

enum UserStatus {
  Pending
  Approved
  Suspended
}

enum AttendanceStatus {
  Pending
  Approved
  Rejected
  Registered
}
