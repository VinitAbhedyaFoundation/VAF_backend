{
    "version": 2,
    "builds": [
        {
            "src": "src/main.ts",
            "use": "@vercel/node@3.2.24",
            "config": {
                "includeFiles": [
                    "prisma/schema.prisma",
                    "node_modules/.prisma/client/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/main.ts"
        }
    ]
}